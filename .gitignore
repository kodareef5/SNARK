# Operating system and editor output
.DS_Store
Thumbs.db
*.swp
*.swo

# Dependencies, build output, and caches
node_modules/
dist/
build/
.cache/
*.tsbuildinfo

# Secrets and machine-specific configuration
.env
.env.*
!.env.example
*.pem
*.key

# Local world state and SQLite sidecars
/var/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
