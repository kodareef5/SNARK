{
  "name": "snark",
  "version": "0.0.14",
  "private": true,
  "type": "module",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./grunt/extension.ts"]
  },
  "engines": {
    "bun": "1.4.3"
  },
  "scripts": {
    "check": "bun tools/check.ts",
    "slow": "bun tools/check.ts --slow-only",
    "ci": "bun tools/ci.ts",
    "test": "bun test",
    "bench": "bun tools/bench.ts",
    "dev": "bun --watch tools/dev.ts",
    "agent": "bun agent/main.ts",
    "build": "bun tools/build-client.ts",
    "title:retake": "bun tools/title/retake.ts",
    "snap": "bun tools/snap.ts",
    "icons": "bun tools/icons.ts",
    "probe": "bun tools/probe.ts",
    "device": "bun tools/device.ts",
    "art": "bun tools/art.ts",
    "screens": "bun tools/screens/media.ts",
    "settings": "bun tools/settings.ts",
    "supply": "bun tools/supply.ts",
    "catalogue": "bun tools/catalogue.ts",
    "cluster-trip": "bun tools/cluster-trip.ts",
    "bed-trip": "bun tools/bed-trip.ts",
    "agent-trip": "bun tools/agent-trip.ts",
    "map-trip": "bun tools/map/trip.ts",
    "events": "bun tools/events.ts",
    "sounds": "bun tools/sounds.ts",
    "wiki": "bun tools/wiki.ts",
    "source": "bun tools/source.ts",
    "media": "python3 tools/release/media.py"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
